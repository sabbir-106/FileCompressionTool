    private void compressButtonActionPerformed(java.awt.event.ActionEvent evt) {                                               
if (selectedFile == null) {
        statusLabel.setText("Please select a file first.");
        return;
    }

    JFileChooser chooser = new JFileChooser();

    chooser.setSelectedFile(
        new File(selectedFile.getName() + ".zip")
    );

    int result = chooser.showSaveDialog(this);

    if (result == JFileChooser.APPROVE_OPTION) {

        File outputZip = chooser.getSelectedFile();

        try {

            ZipCompressor.compressFile(selectedFile, outputZip);

            statusLabel.setText("Compression completed!");

        } catch (Exception e) {

            statusLabel.setText("Compression failed.");

            e.printStackTrace();
        }
    }
    }                                              

    private void decompressButtonActionPerformed(java.awt.event.ActionEvent evt) {                                                 
    JFileChooser fileChooser = new JFileChooser();

fileChooser.setDialogTitle("Select ZIP File");

int result = fileChooser.showOpenDialog(this);

if (result == JFileChooser.APPROVE_OPTION) {

    File zipFile = fileChooser.getSelectedFile();

    JFileChooser folderChooser = new JFileChooser();

    folderChooser.setDialogTitle("Select Output Folder");
    folderChooser.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);

    int folderResult = folderChooser.showOpenDialog(this);

    if (folderResult == JFileChooser.APPROVE_OPTION) {

        File outputFolder = folderChooser.getSelectedFile();

        try {

            ZipDecompressor.decompressFile(zipFile, outputFolder);

            JOptionPane.showMessageDialog(
                    this,
                    "File decompressed successfully!"
            );

        } catch (IOException e) {

            JOptionPane.showMessageDialog(
                    this,
                    "Error while decompressing the file."
            );
        }
    }
}
